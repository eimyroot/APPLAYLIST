{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-library-root",
  "description": "Allow the local main window to select a library root and control only its bounded APPLAYLIST import job lifecycle.",
  "local": true,
  "windows": [
    "main"
  ],
  "platforms": [
    "macOS"
  ],
  "permissions": [
    "allow-library-choose-root",
    "allow-library-import-start",
    "allow-library-import-status",
    "allow-library-import-cancel"
  ]
}