{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APPLAYLIST",
  "version": "0.1.0",
  "identifier": "com.applaylist.desktop.proof",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../frontend/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "APPLAYLIST Desktop Proof",
        "width": 900,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "createUpdaterArtifacts": false
  }
}
